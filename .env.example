# --- LLM (optional). Leave OPENAI_API_KEY empty to use rule mode. ---
OPENAI_API_KEY=
# Only for OpenAI-compatible providers such as Groq: https://api.groq.com/openai/v1
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_MAX_RETRIES=2

# --- CRM webhook (optional). If empty, the CRM step is skipped. ---
CRM_WEBHOOK_URL=
# If set, each request carries an X-Signature header (SHA-256 HMAC of the body).
CRM_WEBHOOK_SECRET=

LOG_LEVEL=INFO
